{
  "name": "footage-finder",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Search your footage, screenshots, slides and voice memos by text, voice or image — offline.",
  "engines": {
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "broapp dev",
    "build": "broapp build",
    "build:page": "broapp build --page",
    "build:all": "broapp build --all-targets",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "broapp": "^0.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.2"
  }
}
